# Which model does which step. Copy to .claudex.yaml and edit.
# Repo config wins over ~/.claude/claudex.yaml, which wins over built-in defaults.
# Check with:  python scripts/claudex_roles.py --explain
# Full reference and the reasoning: ROLES.md

roles:
  plan:        claude    # Claude is in the conversation and holds project context
  plan-review: codex     # graded cold by a foreign context
  build:       claude
  code-review: codex
  exposure-review: codex   # second grader of build: only what faces the network
  docs:        claude
  docs-review: codex
  audit:       codex     # standalone adversary - judges code nobody here produced

actors:
  codex:
    model: gpt-5.6-terra   # NOT sol - it runs into the 10-minute ceiling on real plans
    effort: high
    sandbox: read-only     # the ONLY accepted value; anything else is refused outright
    roles:                 # per-role model/effort; the sandbox cannot be overridden here
      exposure-review:
        model: gpt-5.6-sol # stronger model, bounded input: only the exposed components
        effort: medium     # medium keeps sol inside the ceiling on that input
  claude:
    fresh_subagent: true   # as a reviewer, never the orchestrator that built it
  fallback: [lmstudio]     # when the assigned actor is out of quota - user decides, never automatic

rules:
  write_access: [plan, build, docs] # only these may open a sandbox

# producer_never_reviews and adversary_read_only are NOT listed here on purpose:
# they are always on and cannot be set false. Writing `producer_never_reviews:
# false` is refused with exit 2, not honoured. Until 2026-08-30 both were ordinary
# config, so a `.claudex.yaml` inside the repo being reviewed could switch off the
# two rules that make the whole arrangement mean anything -- and the resolver
# still printed "gates OK". A rule a subject can waive is not a rule.
#
# The config is read from the REPO ROOT only (or ~/.claude/claudex.yaml). A file
# in a subdirectory is ignored: policy a nested folder can redefine is not policy.

# --- Delegation: hand the build to Codex, and the reviewer flips with it -------
# Use when Claude's context is the bottleneck (mechanical migrations, wide
# refactors, a bug with a known repro). This is the only arrangement that opens
# a sandbox.
#
# roles:
#   build:       codex
#   code-review: claude
#   exposure-review: claude   # flips with code-review: the maker never grades its own doors

# --- Dual draft: both models plan the same task blind, then grade each other ---
# Costs two plans. Worth it where a wrong problem framing is expensive - data
# models, tenant isolation, migrations - because a reviewer reading the
# producer's document inherits its framing.
#
# roles:
#   plan:        [claude, codex]
#   plan-review: cross
