# Reviewer credentials/config — never commit (see .env.example for the template)
.env
__pycache__/

# Lokale Marketplace-/Berechtigungs-Overrides: maschinenspezifische absolute Pfade.
.claude/settings.local.json

# Interne Review-Ledger: protokollieren ja, veroeffentlichen nein.
# Die Doktrin verlangt den Log, nicht seine Publikation - Ausnahme ist die
# audit-Baseline, gegen die spaetere Reviews diffen (die gehoert committet).
docs/self-review/

# Build-Metadaten aus `pip install .` — entsteht durch das setuptools-Backend
# in pyproject.toml, gehoert nie ins Repo.
#
# Die Slashes vorn sind Pflicht: ein blosses `build/` matcht JEDES Verzeichnis
# dieses Namens in jeder Tiefe — also auch `skills/build/`, den Build-Skill.
# Dessen SKILL.md ist getrackt und war daher unberuehrt, aber jede NEUE Datei
# darin waere stillschweigend ignoriert worden.
*.egg-info/
/build/
/dist/

# Playwright-MCP-Ausgaben (Screenshots, Snapshots, Konsolenlogs) - Vorgabe 14.09.2026
.playwright-mcp/

# Arbeitsverzeichnis fuer Zwischenstaende. CLAUDE.md nennt es seit jeher als den
# Ort statt /tmp und behauptet dabei, es sei ignoriert -- was bis zum 16.09.2026
# nicht stimmte: wer der eigenen Regel folgte, hatte danach einen untrackten
# Ordner im Repo-Root, den der Repo-Root-Waechter meldet.
.claudex-tmp/

# Arbeitslisten und Plaene des Eigners. Dieser Fork ist oeffentlich; Aufgaben und
# Plaene nennen mit der Zeit zwangslaeufig Dinge, die nicht hierher gehoeren (andere
# Repos, Infrastruktur, Entscheidungen). Das Repo bleibt lokal fuehrend, gespiegelt
# wird nach Jira (docs/todos/README.md, T11) -- nicht nach GitHub. Was aus einem Plan
# oeffentlich belegt werden soll, wandert als Destillat nach docs/audit/.
docs/todos/
docs/plans/
